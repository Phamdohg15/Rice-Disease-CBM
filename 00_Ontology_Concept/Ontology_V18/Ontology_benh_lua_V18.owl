  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#E14">
    <ex:bookSection>8.2.1.5</ex:bookSection>
    <ex:code>E14</ex:code>
    <ex:evidenceAbout rdf:resource="http://example.org/rice-cbm/ontology/v18#D_KhoVan"/>
    <ex:evidenceFrom rdf:resource="http://example.org/rice-cbm/ontology/v18#S01"/>
    <ex:limitation xml:lang="vi">Lưu chuỗi tên theo sách; không tự khẳng định quan hệ phân loại hiện hành bằng owl:sameAs.</ex:limitation>
    <ex:meaningUsed xml:lang="vi">Tên tác nhân khô vằn được sách ghi.</ex:meaningUsed>
    <ex:pdfPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">155</ex:pdfPage>
    <ex:printedPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">143</ex:printedPage>
    <ex:quote xml:lang="vi">Thanatephorus cucumeris (Rhizoctonia solani Kuhn)</ex:quote>
    <ex:statementType xml:lang="vi">Tên tác nhân theo nguồn</ex:statementType>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#Evidence"/>
