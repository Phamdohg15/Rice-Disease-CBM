  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#E26">
    <ex:bookSection>8.2.2.1</ex:bookSection>
    <ex:code>E26</ex:code>
    <ex:evidenceAbout rdf:resource="http://example.org/rice-cbm/ontology/v18#D_BacLa"/>
    <ex:evidenceFrom rdf:resource="http://example.org/rice-cbm/ontology/v18#S01"/>
    <ex:limitation xml:lang="vi">Chưa kiểm tra hình trang gốc để phân biệt lỗi in và lỗi nhận dạng chữ. Không dùng chuỗi này để khẳng định tên phân loại hiện hành.</ex:limitation>
    <ex:meaningUsed xml:lang="vi">Chuỗi tên tác nhân bạc lá trong văn bản trích xuất.</ex:meaningUsed>
    <ex:pdfPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">157</ex:pdfPage>
    <ex:printedPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">145</ex:printedPage>
    <ex:quote xml:lang="vi">Xanthomonas campestris pv. oyzae</ex:quote>
    <ex:statementType xml:lang="vi">Tên tác nhân theo nguồn</ex:statementType>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#Evidence"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">E26 – Bạc lá</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#E27">
    <ex:bookSection>8.2.1.6</ex:bookSection>
