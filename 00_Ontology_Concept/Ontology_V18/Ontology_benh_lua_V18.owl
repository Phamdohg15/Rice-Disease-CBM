    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">E27 – Bối cảnh ngoài 4 bệnh</rdfs:label>
  </rdf:Description>
