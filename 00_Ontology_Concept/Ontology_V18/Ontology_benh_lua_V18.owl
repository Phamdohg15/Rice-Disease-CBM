    <ex:meaningUsed xml:lang="vi">Tên đốm vằn, khô vằn và ung thư trong giáo trình.</ex:meaningUsed>
    <ex:pdfPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">155</ex:pdfPage>
    <ex:printedPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">143</ex:printedPage>
    <ex:quote xml:lang="vi">còn gọi là khô vằn hay ung thư</ex:quote>
    <ex:statementType xml:lang="vi">Tên bệnh theo nguồn</ex:statementType>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#Evidence"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">E13 – Khô vằn</rdfs:label>
