  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#OutOfScopeDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="vi">Bệnh ngoài phạm vi (bối cảnh)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#P01">
    <ex:code>P01</ex:code>
    <ex:combinationEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E01"/>
    <ex:combinationEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E02"/>
    <ex:combinationEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E03"/>
    <ex:combinationFor rdf:resource="http://example.org/rice-cbm/ontology/v18#D_DaoOn"/>
    <ex:combinationScope rdf:resource="http://example.org/rice-cbm/ontology/v18#U_TungVet"/>
    <ex:combinationStatus>RESEARCH_QUERY_NOT_DIAGNOSTIC</ex:combinationStatus>
    <ex:evaluableFromModel rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ex:evaluableFromModel>
    <ex:interpretation xml:lang="vi">C05 có thể bổ sung mô tả; thiếu C05 không tự loại đạo ôn. Đầu ra là phù hợp tổ hợp mô tả. Không có mức mạnh/rất mạnh hoặc xác suất. Thiếu tổ hợp không loại trừ bệnh.</ex:interpretation>
    <ex:limitation xml:lang="vi">Mô hình CBM hiện không dự đoán C02 (chưa vào bottleneck) nên chỉ đánh giá được một phần tổ hợp.</ex:limitation>
    <ex:optionalConcept rdf:resource="http://example.org/rice-cbm/ontology/v18#C05"/>
    <ex:printedPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">141</ex:printedPage>
    <ex:requiresConcept rdf:resource="http://example.org/rice-cbm/ontology/v18#C01"/>
    <ex:requiresConcept rdf:resource="http://example.org/rice-cbm/ontology/v18#C02"/>
    <ex:requiresConcept rdf:resource="http://example.org/rice-cbm/ontology/v18#C03"/>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#CandidateCombination"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">Tổ hợp phù hợp mô tả đạo ôn</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#P02">
    <ex:code>P02</ex:code>
    <ex:combinationEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E08"/>
    <ex:combinationEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E09"/>
    <ex:combinationEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E10"/>
    <ex:combinationFor rdf:resource="http://example.org/rice-cbm/ontology/v18#D_DomNau"/>
    <ex:combinationScope rdf:resource="http://example.org/rice-cbm/ontology/v18#U_TungVet"/>
    <ex:combinationStatus>RESEARCH_QUERY_NOT_DIAGNOSTIC</ex:combinationStatus>
    <ex:evaluableFromModel rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ex:evaluableFromModel>
    <ex:interpretation xml:lang="vi">Đặc điểm nhiều đốm rời rạc của bản cũ đã bị loại. Không thấy rõ vòng đồng tâm là 9, không phải bằng chứng loại bệnh. Đầu ra là phù hợp tổ hợp mô tả. Không có mức mạnh/rất mạnh hoặc xác suất. Thiếu tổ hợp không loại trừ bệnh.</ex:interpretation>
    <ex:limitation xml:lang="vi">Mô hình CBM hiện không dự đoán C08 (chưa vào bottleneck) nên chỉ đánh giá được một phần tổ hợp.</ex:limitation>
    <ex:printedPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">142</ex:printedPage>
    <ex:requiresConcept rdf:resource="http://example.org/rice-cbm/ontology/v18#C03"/>
    <ex:requiresConcept rdf:resource="http://example.org/rice-cbm/ontology/v18#C06"/>
    <ex:requiresConcept rdf:resource="http://example.org/rice-cbm/ontology/v18#C07"/>
    <ex:requiresConcept rdf:resource="http://example.org/rice-cbm/ontology/v18#C08"/>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#CandidateCombination"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">Tổ hợp phù hợp mô tả đốm nâu</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#P03">
    <ex:code>P03</ex:code>
    <ex:combinationEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E21"/>
    <ex:combinationEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E22"/>
    <ex:combinationEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E23"/>
    <ex:combinationEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E24"/>
    <ex:combinationFor rdf:resource="http://example.org/rice-cbm/ontology/v18#D_BacLa"/>
    <ex:combinationScope rdf:resource="http://example.org/rice-cbm/ontology/v18#U_CungVungTrenLa"/>
    <ex:combinationStatus>RESEARCH_QUERY_NOT_DIAGNOSTIC</ex:combinationStatus>
    <ex:evaluableFromModel rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:evaluableFromModel>
    <ex:interpretation xml:lang="vi">C09 là vị trí quan sát, không khẳng định khởi phát; C04 có thể bổ sung. Đầu ra là phù hợp tổ hợp mô tả. Không có mức mạnh/rất mạnh hoặc xác suất. Thiếu tổ hợp không loại trừ bệnh. (v1.8: C10 nay gồm cả màu xám của khô vằn; cần C09 + C11 đi kèm để phù hợp bạc lá.)</ex:interpretation>
    <ex:optionalConcept rdf:resource="http://example.org/rice-cbm/ontology/v18#C04"/>
    <ex:printedPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">145</ex:printedPage>
    <ex:requiresConcept rdf:resource="http://example.org/rice-cbm/ontology/v18#C09"/>
    <ex:requiresConcept rdf:resource="http://example.org/rice-cbm/ontology/v18#C10"/>
    <ex:requiresConcept rdf:resource="http://example.org/rice-cbm/ontology/v18#C11"/>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#CandidateCombination"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">Tổ hợp phù hợp mô tả bạc lá</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#P04">
    <ex:code>P04</ex:code>
    <ex:combinationEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E15"/>
    <ex:combinationEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E16"/>
    <ex:combinationEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E17"/>
    <ex:combinationFor rdf:resource="http://example.org/rice-cbm/ontology/v18#D_KhoVan"/>
    <ex:combinationScope rdf:resource="http://example.org/rice-cbm/ontology/v18#U_BeLa"/>
    <ex:combinationStatus>RESEARCH_QUERY_NOT_DIAGNOSTIC</ex:combinationStatus>
    <ex:evaluableFromModel rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ex:evaluableFromModel>
    <ex:interpretation xml:lang="vi">Phù hợp một phần mô tả màu và vị trí; xem thêm C06 hoặc C15. Không dùng C13 đơn độc. Đầu ra là phù hợp tổ hợp mô tả. Không có mức mạnh/rất mạnh hoặc xác suất. Thiếu tổ hợp không loại trừ bệnh. (v1.8: C17 đã gộp vào C10.)</ex:interpretation>
    <ex:limitation xml:lang="vi">Mô hình CBM hiện không dự đoán C13 (chưa vào bottleneck) nên chỉ đánh giá được một phần tổ hợp.</ex:limitation>
    <ex:optionalConcept rdf:resource="http://example.org/rice-cbm/ontology/v18#C06"/>
    <ex:optionalConcept rdf:resource="http://example.org/rice-cbm/ontology/v18#C15"/>
    <ex:printedPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">143</ex:printedPage>
    <ex:requiresConcept rdf:resource="http://example.org/rice-cbm/ontology/v18#C03"/>
    <ex:requiresConcept rdf:resource="http://example.org/rice-cbm/ontology/v18#C10"/>
    <ex:requiresConcept rdf:resource="http://example.org/rice-cbm/ontology/v18#C13"/>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#CandidateCombination"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">Tổ hợp phù hợp mô tả vết khô vằn trên bẹ</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#RiceDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="vi">Bệnh lúa mục tiêu</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://example.org/rice-cbm/ontology/v18#DatasetClass"/>
