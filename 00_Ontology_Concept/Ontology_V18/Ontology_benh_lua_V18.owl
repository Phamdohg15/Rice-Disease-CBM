<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF xmlns:dcterms="http://purl.org/dc/terms/" xmlns:ex="http://example.org/rice-cbm/ontology/v18#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="vi">16 concept C01–C16 theo Bang_concept_v1_8. Nguồn bệnh học duy nhất: S01 Giáo trình Cây lúa (2008). Tổ hợp P01–P04 là thiết kế truy vấn nghiên cứu, không phải luật chẩn đoán. Không có SWRL hoặc tiên đề điều kiện đủ.</rdfs:comment>
    <rdfs:label xml:lang="vi">Ontology bệnh lúa cho CBM – concept V1.8</rdfs:label>
    <owl:priorVersion rdf:resource="https://example.org/rice-v16-two-books"/>
    <owl:versionInfo>1.8.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#BacterialDisease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="vi">Bệnh do vi khuẩn</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://example.org/rice-cbm/ontology/v18#RiceDisease"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#C01">
    <ex:assignedPer rdf:resource="http://example.org/rice-cbm/ontology/v18#U_TungVet"/>
    <ex:basis xml:lang="vi">Trực tiếp từ giáo trình</ex:basis>
    <ex:bottleneckStatus xml:lang="vi">Đưa vào bottleneck</ex:bottleneckStatus>
    <ex:bottleneckTodo xml:lang="vi">Rà lại ảnh đạo ôn (phóng to); bổ sung ảnh rõ dấu từ bộ paddy.</ex:bottleneckTodo>
    <ex:code>C01</ex:code>
    <ex:conceptStatus>ACTIVE_SOURCE</ex:conceptStatus>
    <ex:describedForDisease rdf:resource="http://example.org/rice-cbm/ontology/v18#D_DaoOn"/>
    <ex:hasEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E01"/>
    <ex:migrationFromV17 xml:lang="vi">Giữ nguyên mã và nhãn v1.7.</ex:migrationFromV17>
    <ex:observableOnLeafImages rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:observableOnLeafImages>
    <ex:rule0 xml:lang="vi">Vùng cần xét đủ rõ và xác nhận không có đặc điểm này; không suy từ nhãn bệnh.</ex:rule0>
    <ex:rule1 xml:lang="vi">Vùng cần xét đủ rõ và có đặc điểm đúng định nghĩa; lưu định danh vết/vùng tương ứng.</ex:rule1>
    <ex:rule9 xml:lang="vi">Không thấy đủ vùng cần xét, ảnh mờ, bị che/cắt hoặc không đủ chi tiết để quyết định.</ex:rule9>
    <ex:sourcePages xml:lang="vi">S01, tr. 141</ex:sourcePages>
    <ex:trainNegative rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">489</ex:trainNegative>
    <ex:trainPositive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">112</ex:trainPositive>
    <ex:trainUnknown rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2049</ex:trainUnknown>
    <ex:usedInBottleneck rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:usedInBottleneck>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#VisualConcept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">Vết hình mắt én, hai đầu hẹp, giữa phình</rdfs:label>
    <skos:definition xml:lang="vi">Một vết có phần giữa phình và hai đầu hẹp, tạo hình mắt én. Không yêu cầu hướng theo chiều lá.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#C02">
    <ex:assignedPer rdf:resource="http://example.org/rice-cbm/ontology/v18#U_TungVet"/>
    <ex:basis xml:lang="vi">Trực tiếp từ giáo trình</ex:basis>
    <ex:bottleneckStatus xml:lang="vi">Chờ rà lại (chưa đủ dữ liệu)</ex:bottleneckStatus>
    <ex:bottleneckTodo xml:lang="vi">Như C01.</ex:bottleneckTodo>
    <ex:code>C02</ex:code>
    <ex:conceptStatus>ACTIVE_SOURCE</ex:conceptStatus>
    <ex:describedForDisease rdf:resource="http://example.org/rice-cbm/ontology/v18#D_DaoOn"/>
    <ex:hasEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E01"/>
    <ex:migrationFromV17 xml:lang="vi">Giữ nguyên mã và nhãn v1.7.</ex:migrationFromV17>
    <ex:observableOnLeafImages rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:observableOnLeafImages>
    <ex:rule0 xml:lang="vi">Vùng cần xét đủ rõ và xác nhận không có đặc điểm này; không suy từ nhãn bệnh.</ex:rule0>
    <ex:rule1 xml:lang="vi">Vùng cần xét đủ rõ và có đặc điểm đúng định nghĩa; lưu định danh vết/vùng tương ứng.</ex:rule1>
    <ex:rule9 xml:lang="vi">Không thấy đủ vùng cần xét, ảnh mờ, bị che/cắt hoặc không đủ chi tiết để quyết định.</ex:rule9>
    <ex:sourcePages xml:lang="vi">S01, tr. 141</ex:sourcePages>
    <ex:trainNegative rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">236</ex:trainNegative>
    <ex:trainPositive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">33</ex:trainPositive>
    <ex:trainUnknown rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2381</ex:trainUnknown>
    <ex:usedInBottleneck rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ex:usedInBottleneck>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#VisualConcept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">Phần giữa vết bệnh màu xám tro</rdfs:label>
    <skos:definition xml:lang="vi">Phần giữa của vết bệnh có màu xám tro; không đồng nhất màu giữa vết với màu toàn vết hoặc màu trắng.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#C03">
    <ex:assignedPer rdf:resource="http://example.org/rice-cbm/ontology/v18#U_TungVet"/>
    <ex:basis xml:lang="vi">Trực tiếp từ giáo trình</ex:basis>
    <ex:bottleneckStatus xml:lang="vi">Đưa vào bottleneck</ex:bottleneckStatus>
    <ex:code>C03</ex:code>
    <ex:conceptStatus>ACTIVE_SOURCE</ex:conceptStatus>
    <ex:describedForDisease rdf:resource="http://example.org/rice-cbm/ontology/v18#D_DaoOn"/>
    <ex:describedForDisease rdf:resource="http://example.org/rice-cbm/ontology/v18#D_DomNau"/>
    <ex:describedForDisease rdf:resource="http://example.org/rice-cbm/ontology/v18#D_KhoVan"/>
    <ex:hasEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E02"/>
    <ex:hasEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E09"/>
    <ex:hasEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E16"/>
    <ex:migrationFromV17 xml:lang="vi">Giữ nguyên mã và nhãn v1.7.</ex:migrationFromV17>
    <ex:observableOnLeafImages rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:observableOnLeafImages>
    <ex:rule0 xml:lang="vi">Vùng cần xét đủ rõ và xác nhận không có đặc điểm này; không suy từ nhãn bệnh.</ex:rule0>
    <ex:rule1 xml:lang="vi">Vùng cần xét đủ rõ và có đặc điểm đúng định nghĩa; lưu định danh vết/vùng tương ứng.</ex:rule1>
    <ex:rule9 xml:lang="vi">Không thấy đủ vùng cần xét, ảnh mờ, bị che/cắt hoặc không đủ chi tiết để quyết định.</ex:rule9>
    <ex:sourcePages xml:lang="vi">S01, tr. 141; 142; 143</ex:sourcePages>
    <ex:trainNegative rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">234</ex:trainNegative>
    <ex:trainPositive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1922</ex:trainPositive>
    <ex:trainUnknown rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">494</ex:trainUnknown>
    <ex:usedInBottleneck rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:usedInBottleneck>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#VisualConcept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">Viền vết bệnh màu nâu</rdfs:label>
    <skos:definition xml:lang="vi">Dải màu nâu tạo viền quanh vết; đốm nâu được mô tả viền nâu sậm. Không mở rộng riêng thành nâu đỏ khi sách chưa nêu.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#C04">
    <ex:assignedPer rdf:resource="http://example.org/rice-cbm/ontology/v18#U_CungVungTrenLa"/>
    <ex:basis xml:lang="vi">Diễn giải gán ảnh từ giáo trình</ex:basis>
    <ex:bottleneckStatus xml:lang="vi">Đưa vào bottleneck</ex:bottleneckStatus>
    <ex:code>C04</ex:code>
    <ex:conceptStatus>ACTIVE_OPERATIONAL_FROM_SOURCE</ex:conceptStatus>
    <ex:describedForDisease rdf:resource="http://example.org/rice-cbm/ontology/v18#D_BacLa"/>
    <ex:hasEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E22"/>
    <ex:migrationFromV17 xml:lang="vi">Giữ nguyên mã và nhãn v1.7.</ex:migrationFromV17>
    <ex:observableOnLeafImages rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:observableOnLeafImages>
    <ex:rule0 xml:lang="vi">Vùng cần xét đủ rõ và xác nhận không có đặc điểm này; không suy từ nhãn bệnh.</ex:rule0>
    <ex:rule1 xml:lang="vi">Vùng cần xét đủ rõ và có đặc điểm đúng định nghĩa; lưu định danh vết/vùng tương ứng.</ex:rule1>
    <ex:rule9 xml:lang="vi">Không thấy đủ vùng cần xét, ảnh mờ, bị che/cắt hoặc không đủ chi tiết để quyết định.</ex:rule9>
    <ex:sourcePages xml:lang="vi">S01, tr. 145</ex:sourcePages>
    <ex:trainNegative rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">346</ex:trainNegative>
    <ex:trainPositive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2043</ex:trainPositive>
    <ex:trainUnknown rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">261</ex:trainUnknown>
    <ex:usedInBottleneck rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:usedInBottleneck>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#VisualConcept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">Vùng tổn thương kéo dài theo hướng gân lá</rdfs:label>
    <skos:definition xml:lang="vi">Vùng tổn thương quan sát được có hướng kéo dài dọc gân lá. Đây là diễn giải để gán trạng thái ảnh từ mô tả diễn tiến trong sách.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#C05">
    <ex:assignedPer rdf:resource="http://example.org/rice-cbm/ontology/v18#U_TungVet"/>
    <ex:basis xml:lang="vi">Trực tiếp từ giáo trình</ex:basis>
    <ex:bottleneckStatus xml:lang="vi">Đưa vào bottleneck</ex:bottleneckStatus>
    <ex:bottleneckTodo xml:lang="vi">Đủ tối thiểu; theo dõi AUC.</ex:bottleneckTodo>
    <ex:code>C05</ex:code>
    <ex:conceptStatus>ACTIVE_SOURCE</ex:conceptStatus>
    <ex:describedForDisease rdf:resource="http://example.org/rice-cbm/ontology/v18#D_DaoOn"/>
    <ex:hasEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E03"/>
    <ex:migrationFromV17 xml:lang="vi">Giữ nguyên mã và nhãn v1.7.</ex:migrationFromV17>
    <ex:observableOnLeafImages rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:observableOnLeafImages>
    <ex:rule0 xml:lang="vi">Vùng cần xét đủ rõ và xác nhận không có đặc điểm này; không suy từ nhãn bệnh.</ex:rule0>
    <ex:rule1 xml:lang="vi">Vùng cần xét đủ rõ và có đặc điểm đúng định nghĩa; lưu định danh vết/vùng tương ứng.</ex:rule1>
    <ex:rule9 xml:lang="vi">Không thấy đủ vùng cần xét, ảnh mờ, bị che/cắt hoặc không đủ chi tiết để quyết định.</ex:rule9>
    <ex:sourcePages xml:lang="vi">S01, tr. 141</ex:sourcePages>
    <ex:trainNegative rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">319</ex:trainNegative>
    <ex:trainPositive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">206</ex:trainPositive>
    <ex:trainUnknown rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2125</ex:trainUnknown>
    <ex:usedInBottleneck rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:usedInBottleneck>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#VisualConcept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">Quầng vàng phía ngoài viền nâu của vết</rdfs:label>
    <skos:definition xml:lang="vi">Vùng vàng tạo quầng phía ngoài viền nâu của cùng một vết. Phân biệt với vàng cả lá hoặc sọc vàng.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#C06">
