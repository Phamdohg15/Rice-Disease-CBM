  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#E22">
    <ex:bookSection>8.2.2.1</ex:bookSection>
    <ex:code>E22</ex:code>
    <ex:evidenceAbout rdf:resource="http://example.org/rice-cbm/ontology/v18#D_BacLa"/>
    <ex:evidenceFrom rdf:resource="http://example.org/rice-cbm/ontology/v18#S01"/>
    <ex:limitation xml:lang="vi">C04 chỉ gán hướng quan sát được; C09 chỉ gán vị trí tiếp giáp.</ex:limitation>
    <ex:meaningUsed xml:lang="vi">Bạc lá có diễn tiến dọc gân và từ bìa vào trong.</ex:meaningUsed>
    <ex:pdfPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">157</ex:pdfPage>
    <ex:printedPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">145</ex:printedPage>
    <ex:quote xml:lang="vi">lan rộng và dọc theo các gân lá và từ bìa lá vào trong</ex:quote>
    <ex:statementType xml:lang="vi">Diễn tiến</ex:statementType>
