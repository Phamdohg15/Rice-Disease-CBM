    <ex:conceptStatus>ACTIVE_SOURCE</ex:conceptStatus>
    <ex:describedForDisease rdf:resource="http://example.org/rice-cbm/ontology/v18#D_DomNau"/>
    <ex:hasEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E10"/>
    <ex:migrationFromV17 xml:lang="vi">Giữ nguyên mã và nhãn v1.7.</ex:migrationFromV17>
    <ex:observableOnLeafImages rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:observableOnLeafImages>
    <ex:rule0 xml:lang="vi">Vùng cần xét đủ rõ và xác nhận không có đặc điểm này; không suy từ nhãn bệnh.</ex:rule0>
    <ex:rule1 xml:lang="vi">Vùng cần xét đủ rõ và có đặc điểm đúng định nghĩa; lưu định danh vết/vùng tương ứng.</ex:rule1>
    <ex:rule9 xml:lang="vi">Không thấy đủ vùng cần xét, ảnh mờ, bị che/cắt hoặc không đủ chi tiết để quyết định.</ex:rule9>
    <ex:sourcePages xml:lang="vi">S01, tr. 142</ex:sourcePages>
    <ex:trainNegative rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">377</ex:trainNegative>
    <ex:trainPositive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</ex:trainPositive>
    <ex:trainUnknown rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2265</ex:trainUnknown>
    <ex:usedInBottleneck rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ex:usedInBottleneck>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#VisualConcept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">Vòng đồng tâm bên trong vết đốm</rdfs:label>
    <skos:definition xml:lang="vi">Trong cùng một vết đốm thấy cấu trúc các vòng đồng tâm.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#C09">
    <ex:assignedPer rdf:resource="http://example.org/rice-cbm/ontology/v18#U_CungVungTrenLa"/>
    <ex:basis xml:lang="vi">Diễn giải gán ảnh từ giáo trình</ex:basis>
    <ex:bottleneckStatus xml:lang="vi">Đưa vào bottleneck</ex:bottleneckStatus>
    <ex:code>C09</ex:code>
    <ex:conceptStatus>ACTIVE_OPERATIONAL_FROM_SOURCE</ex:conceptStatus>
    <ex:describedForDisease rdf:resource="http://example.org/rice-cbm/ontology/v18#D_BacLa"/>
    <ex:hasEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E21"/>
    <ex:hasEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E22"/>
    <ex:migrationFromV17 xml:lang="vi">Giữ nguyên mã và nhãn v1.7.</ex:migrationFromV17>
    <ex:observableOnLeafImages rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:observableOnLeafImages>
    <ex:rule0 xml:lang="vi">Vùng cần xét đủ rõ và xác nhận không có đặc điểm này; không suy từ nhãn bệnh.</ex:rule0>
    <ex:rule1 xml:lang="vi">Vùng cần xét đủ rõ và có đặc điểm đúng định nghĩa; lưu định danh vết/vùng tương ứng.</ex:rule1>
    <ex:rule9 xml:lang="vi">Không thấy đủ vùng cần xét, ảnh mờ, bị che/cắt hoặc không đủ chi tiết để quyết định.</ex:rule9>
    <ex:sourcePages xml:lang="vi">S01, tr. 145</ex:sourcePages>
    <ex:trainNegative rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">618</ex:trainNegative>
    <ex:trainPositive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1625</ex:trainPositive>
    <ex:trainUnknown rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">407</ex:trainUnknown>
    <ex:usedInBottleneck rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:usedInBottleneck>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#VisualConcept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">Tổn thương tiếp giáp chóp hoặc mép lá</rdfs:label>
    <skos:definition xml:lang="vi">Vùng tổn thương có tiếp giáp quan sát được với chóp hoặc mép lá; không suy điểm khởi phát hay hướng lan.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#C10">
    <ex:assignedPer rdf:resource="http://example.org/rice-cbm/ontology/v18#U_TungVetHoacVung"/>
    <ex:basis xml:lang="vi">Gộp hai phát biểu trực tiếp từ giáo trình</ex:basis>
    <ex:bottleneckStatus xml:lang="vi">Đưa vào bottleneck</ex:bottleneckStatus>
    <ex:code>C10</ex:code>
    <ex:conceptStatus>ACTIVE_MERGED_FROM_SOURCE</ex:conceptStatus>
    <ex:describedForDisease rdf:resource="http://example.org/rice-cbm/ontology/v18#D_BacLa"/>
    <ex:describedForDisease rdf:resource="http://example.org/rice-cbm/ontology/v18#D_KhoVan"/>
    <ex:hasEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E16"/>
    <ex:hasEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E23"/>
    <ex:migrationFromV17 xml:lang="vi">C10 v1.8 = 1 nếu C10 v1.7 = 1 hoặc C17 v1.7 = 1; = 0 nếu cả hai = 0; còn lại = 9.</ex:migrationFromV17>
    <ex:observableOnLeafImages rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:observableOnLeafImages>
    <ex:rule0 xml:lang="vi">Vùng cần xét đủ rõ và xác nhận không có đặc điểm này; không suy từ nhãn bệnh.</ex:rule0>
    <ex:rule1 xml:lang="vi">Vùng cần xét đủ rõ và có đặc điểm đúng định nghĩa; lưu định danh vết/vùng tương ứng.</ex:rule1>
    <ex:rule9 xml:lang="vi">Không thấy đủ vùng cần xét, ảnh mờ, bị che/cắt hoặc không đủ chi tiết để quyết định.</ex:rule9>
    <ex:sourcePages xml:lang="vi">S01, tr. 143; 145</ex:sourcePages>
    <ex:trainNegative rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">366</ex:trainNegative>
    <ex:trainPositive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">789</ex:trainPositive>
    <ex:trainUnknown rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1495</ex:trainUnknown>
    <ex:usedInBottleneck rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:usedInBottleneck>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#VisualConcept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="vi">V1.8 gộp C10 (xám trắng – bạc lá) và C17 (vết màu xám – khô vằn) của V1.7. Không gồm phần giữa xám tro hình mắt én (C02).</rdfs:comment>
    <rdfs:label xml:lang="vi">Vùng/vết tổn thương màu xám – xám trắng</rdfs:label>
    <skos:definition xml:lang="vi">Phần chính của vết hoặc vùng tổn thương có màu xám đến xám trắng, phân biệt với viền nâu. Gộp C10 (xám trắng, bạc lá) và C17 (vết màu xám, khô vằn) của v1.7 vì người gán không phân biệt ổn định hai sắc độ trên ảnh. Không bao gồm phần giữa xám tro của vết hình mắt én (C02).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#C11">
    <ex:assignedPer rdf:resource="http://example.org/rice-cbm/ontology/v18#U_CungVungTrenLa"/>
    <ex:basis xml:lang="vi">Trực tiếp từ giáo trình</ex:basis>
    <ex:bottleneckStatus xml:lang="vi">Đưa vào bottleneck</ex:bottleneckStatus>
    <ex:bottleneckTodo xml:lang="vi">Đủ tối thiểu; theo dõi AUC.</ex:bottleneckTodo>
    <ex:code>C11</ex:code>
    <ex:conceptStatus>ACTIVE_SOURCE</ex:conceptStatus>
    <ex:describedForDisease rdf:resource="http://example.org/rice-cbm/ontology/v18#D_BacLa"/>
    <ex:hasEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E24"/>
    <ex:migrationFromV17 xml:lang="vi">Giữ nguyên mã và nhãn v1.7.</ex:migrationFromV17>
    <ex:observableOnLeafImages rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:observableOnLeafImages>
    <ex:rule0 xml:lang="vi">Vùng cần xét đủ rõ và xác nhận không có đặc điểm này; không suy từ nhãn bệnh.</ex:rule0>
    <ex:rule1 xml:lang="vi">Vùng cần xét đủ rõ và có đặc điểm đúng định nghĩa; lưu định danh vết/vùng tương ứng.</ex:rule1>
    <ex:rule9 xml:lang="vi">Không thấy đủ vùng cần xét, ảnh mờ, bị che/cắt hoặc không đủ chi tiết để quyết định.</ex:rule9>
    <ex:sourcePages xml:lang="vi">S01, tr. 145</ex:sourcePages>
    <ex:trainNegative rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">883</ex:trainNegative>
    <ex:trainPositive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">190</ex:trainPositive>
    <ex:trainUnknown rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1577</ex:trainUnknown>
    <ex:usedInBottleneck rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:usedInBottleneck>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#VisualConcept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">Viền ngoài vùng tổn thương có hình gợn sóng</rdfs:label>
    <skos:definition xml:lang="vi">Đường viền ngoài của vùng tổn thương có hình gợn sóng; không coi mọi ranh giới không đều là gợn sóng.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#C12">
    <ex:assignedPer rdf:resource="http://example.org/rice-cbm/ontology/v18#U_CungVungTrenLa"/>
    <ex:basis xml:lang="vi">Trực tiếp từ giáo trình</ex:basis>
    <ex:bottleneckStatus xml:lang="vi">Đưa vào bottleneck</ex:bottleneckStatus>
    <ex:bottleneckTodo xml:lang="vi">Rà lại nếu còn thời gian.</ex:bottleneckTodo>
    <ex:code>C12</ex:code>
    <ex:conceptStatus>ACTIVE_SOURCE</ex:conceptStatus>
    <ex:describedForDisease rdf:resource="http://example.org/rice-cbm/ontology/v18#D_DaoOn"/>
    <ex:hasEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E04"/>
    <ex:migrationFromV17 xml:lang="vi">Giữ nguyên mã và nhãn v1.7.</ex:migrationFromV17>
    <ex:observableOnLeafImages rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:observableOnLeafImages>
    <ex:rule0 xml:lang="vi">Vùng lá cần xét đủ rõ và không thấy nhiều vết bệnh liên kết với nhau.</ex:rule0>
    <ex:rule1 xml:lang="vi">Quan sát đủ rõ nhiều vết bệnh liên kết với nhau trên cùng lá.</ex:rule1>
    <ex:rule9 xml:lang="vi">Không đủ phạm vi hoặc chi tiết để phân biệt nhiều vết liên kết với một vết đơn hay các vết tách rời.</ex:rule9>
    <ex:sourcePages xml:lang="vi">S01, tr. 141</ex:sourcePages>
    <ex:trainNegative rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">639</ex:trainNegative>
    <ex:trainPositive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">87</ex:trainPositive>
    <ex:trainUnknown rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1924</ex:trainUnknown>
    <ex:usedInBottleneck rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:usedInBottleneck>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#VisualConcept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">Nhiều vết bệnh liên kết với nhau</rdfs:label>
    <skos:definition xml:lang="vi">Nhiều vết bệnh liên kết với nhau trên cùng lá. Giáo trình mô tả ở bệnh đạo ôn: nhiều vết bệnh liên kết lại làm cả lá lúa bị cháy khô. Không thêm điều kiện kích thước lớn hoặc ngưỡng diện tích.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#C13">
    <ex:assignedPer rdf:resource="http://example.org/rice-cbm/ontology/v18#U_BeLa"/>
    <ex:basis xml:lang="vi">Trực tiếp từ giáo trình</ex:basis>
    <ex:bottleneckStatus xml:lang="vi">Chờ rà lại (chưa đủ dữ liệu)</ex:bottleneckStatus>
    <ex:bottleneckTodo xml:lang="vi">Rà lại ảnh khô vằn (bẹ hay phiến).</ex:bottleneckTodo>
    <ex:code>C13</ex:code>
    <ex:conceptStatus>ACTIVE_SOURCE</ex:conceptStatus>
    <ex:describedForDisease rdf:resource="http://example.org/rice-cbm/ontology/v18#D_BacLa"/>
    <ex:describedForDisease rdf:resource="http://example.org/rice-cbm/ontology/v18#D_KhoVan"/>
    <ex:hasEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E15"/>
    <ex:hasEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E25"/>
    <ex:migrationFromV17 xml:lang="vi">Giữ mã. Nhãn v1.7 toàn bộ là 9; rà lại từ ảnh (ưu tiên ảnh khô vằn), phóng to khi gán.</ex:migrationFromV17>
    <ex:observableOnLeafImages rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ex:observableOnLeafImages>
    <ex:rule0 xml:lang="vi">Vùng cần xét đủ rõ và xác nhận không có đặc điểm này; không suy từ nhãn bệnh.</ex:rule0>
    <ex:rule1 xml:lang="vi">Vùng cần xét đủ rõ và có đặc điểm đúng định nghĩa; lưu định danh vết/vùng tương ứng.</ex:rule1>
    <ex:rule9 xml:lang="vi">Không thấy đủ vùng cần xét, ảnh mờ, bị che/cắt hoặc không đủ chi tiết để quyết định.</ex:rule9>
    <ex:sourcePages xml:lang="vi">S01, tr. 143; 145</ex:sourcePages>
    <ex:trainNegative rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</ex:trainNegative>
    <ex:trainPositive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</ex:trainPositive>
    <ex:trainUnknown rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2650</ex:trainUnknown>
    <ex:usedInBottleneck rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ex:usedInBottleneck>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#VisualConcept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="vi">Dữ liệu hiện tại chủ yếu là ảnh phiến lá: toàn bộ nhãn train = 9. Giữ trong ontology như tri thức sách.</rdfs:comment>
    <rdfs:label xml:lang="vi">Tổn thương trên bẹ lá</rdfs:label>
    <skos:definition xml:lang="vi">Tổn thương nằm trên phần bẹ lá được nhận diện đủ rõ trong ảnh. Đây là đặc điểm vị trí dùng chung.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#C14">
    <ex:assignedPer rdf:resource="http://example.org/rice-cbm/ontology/v18#U_TungVet"/>
    <ex:basis xml:lang="vi">Diễn giải gán ảnh từ giáo trình</ex:basis>
    <ex:bottleneckStatus xml:lang="vi">Đưa vào bottleneck</ex:bottleneckStatus>
    <ex:code>C14</ex:code>
    <ex:conceptStatus>ACTIVE_OPERATIONAL_FROM_SOURCE</ex:conceptStatus>
    <ex:describedForDisease rdf:resource="http://example.org/rice-cbm/ontology/v18#D_KhoVan"/>
    <ex:hasEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E17"/>
    <ex:migrationFromV17 xml:lang="vi">Giữ nguyên mã và nhãn v1.7.</ex:migrationFromV17>
    <ex:observableOnLeafImages rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:observableOnLeafImages>
    <ex:rule0 xml:lang="vi">Vùng cần xét đủ rõ và xác nhận không có đặc điểm này; không suy từ nhãn bệnh.</ex:rule0>
    <ex:rule1 xml:lang="vi">Vùng cần xét đủ rõ và có đặc điểm đúng định nghĩa; lưu định danh vết/vùng tương ứng.</ex:rule1>
    <ex:rule9 xml:lang="vi">Không thấy đủ vùng cần xét, ảnh mờ, bị che/cắt hoặc không đủ chi tiết để quyết định.</ex:rule9>
    <ex:sourcePages xml:lang="vi">S01, tr. 143</ex:sourcePages>
    <ex:trainNegative rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">552</ex:trainNegative>
    <ex:trainPositive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1326</ex:trainPositive>
    <ex:trainUnknown rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">772</ex:trainUnknown>
    <ex:usedInBottleneck rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:usedInBottleneck>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#VisualConcept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">Vết tổn thương có hình dạng không đều</rdfs:label>
    <skos:definition xml:lang="vi">Một vết có đường bao không đều. Hình tròn/bầu dục được tách sang C06; không đặt điều kiện vết lớn.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#C15">
    <ex:assignedPer rdf:resource="http://example.org/rice-cbm/ontology/v18#U_CungVungLaHoacBe"/>
    <ex:basis xml:lang="vi">Trực tiếp từ giáo trình</ex:basis>
    <ex:bottleneckStatus xml:lang="vi">Đưa vào bottleneck</ex:bottleneckStatus>
    <ex:bottleneckTodo xml:lang="vi">Đủ tối thiểu; theo dõi AUC.</ex:bottleneckTodo>
    <ex:code>C15</ex:code>
    <ex:conceptStatus>ACTIVE_SOURCE</ex:conceptStatus>
    <ex:describedForDisease rdf:resource="http://example.org/rice-cbm/ontology/v18#D_KhoVan"/>
    <ex:hasEvidence rdf:resource="http://example.org/rice-cbm/ontology/v18#E17"/>
    <ex:migrationFromV17 xml:lang="vi">Giữ nguyên mã và nhãn v1.7.</ex:migrationFromV17>
    <ex:observableOnLeafImages rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:observableOnLeafImages>
    <ex:rule0 xml:lang="vi">Vùng cần xét đủ rõ và xác nhận không có đặc điểm này; không suy từ nhãn bệnh.</ex:rule0>
    <ex:rule1 xml:lang="vi">Vùng cần xét đủ rõ và có đặc điểm đúng định nghĩa; lưu định danh vết/vùng tương ứng.</ex:rule1>
    <ex:rule9 xml:lang="vi">Không thấy đủ vùng cần xét, ảnh mờ, bị che/cắt hoặc không đủ chi tiết để quyết định.</ex:rule9>
    <ex:sourcePages xml:lang="vi">S01, tr. 143</ex:sourcePages>
    <ex:trainNegative rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1800</ex:trainNegative>
    <ex:trainPositive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">180</ex:trainPositive>
    <ex:trainUnknown rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">670</ex:trainUnknown>
    <ex:usedInBottleneck rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:usedInBottleneck>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#VisualConcept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">Vết loang lỗ, vằn vện như da hổ</rdfs:label>
    <skos:definition xml:lang="vi">Vùng tổn thương có biểu hiện loang lỗ, vằn vện gợi kiểu da hổ theo mô tả của giáo trình.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#C16">
    <ex:assignedPer rdf:resource="http://example.org/rice-cbm/ontology/v18#U_PhienLaQuanSat"/>
    <ex:basis xml:lang="vi">Quy ước dự án / không phải phát biểu trực tiếp của sách</ex:basis>
    <ex:bottleneckStatus xml:lang="vi">Đưa vào bottleneck</ex:bottleneckStatus>
    <ex:bottleneckTodo xml:lang="vi">Cắt lá cho 165 ảnh khỏe đang = 9.</ex:bottleneckTodo>
    <ex:code>C16</ex:code>
    <ex:conceptStatus>ACTIVE_PROJECT_LABEL</ex:conceptStatus>
    <ex:migrationFromV17 xml:lang="vi">Giữ mã. Khi C16 = 1, các concept bệnh trên phiến lá (C01–C12, C14, C15) phải là 0, không để 9; C13 giữ theo quan sát bẹ.</ex:migrationFromV17>
    <ex:observableOnLeafImages rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:observableOnLeafImages>
    <ex:rule0 xml:lang="vi">Thấy tổn thương hoặc bất thường rõ trên phần phiến lá cần xét.</ex:rule0>
    <ex:rule1 xml:lang="vi">Phần phiến lá cần xét đủ rõ, không thấy tổn thương rõ trong phạm vi đó.</ex:rule1>
    <ex:rule9 xml:lang="vi">Phiến lá quá mờ, che/cắt hoặc không đủ chi tiết để đánh giá.</ex:rule9>
    <ex:sourcePages xml:lang="vi">Quy ước dự án</ex:sourcePages>
    <ex:trainNegative rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2262</ex:trainNegative>
    <ex:trainPositive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">234</ex:trainPositive>
    <ex:trainUnknown rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">154</ex:trainUnknown>
    <ex:usedInBottleneck rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:usedInBottleneck>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#VisualConcept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="vi">Ràng buộc gán nhãn: C16 = 1 kéo theo C01–C12, C14, C15 = 0 (không để 9); C13 theo quan sát bẹ.</rdfs:comment>
    <rdfs:label xml:lang="vi">Không thấy tổn thương rõ trên phần phiến lá quan sát</rdfs:label>
    <skos:definition xml:lang="vi">Phần phiến lá quan sát được đủ rõ và không thấy tổn thương rõ. Chỉ là nhãn biểu hiện trên ảnh, không kết luận cây khỏe sinh học.</skos:definition>
  </rdf:Description>
