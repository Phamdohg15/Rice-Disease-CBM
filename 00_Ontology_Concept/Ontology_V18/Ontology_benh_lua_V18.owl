    <ex:evidenceFrom rdf:resource="http://example.org/rice-cbm/ontology/v18#S01"/>
    <ex:limitation xml:lang="vi">Màu xám trắng và trạng thái khô cần được xem xét riêng khi gán ảnh.</ex:limitation>
    <ex:meaningUsed xml:lang="vi">Bạc lá: vết dần khô và có màu xám trắng.</ex:meaningUsed>
    <ex:pdfPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">157</ex:pdfPage>
    <ex:printedPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">145</ex:printedPage>
    <ex:quote xml:lang="vi">Vết bệnh dần khô lại có màu xám trắng</ex:quote>
    <ex:statementType xml:lang="vi">Diễn tiến và màu sắc</ex:statementType>
