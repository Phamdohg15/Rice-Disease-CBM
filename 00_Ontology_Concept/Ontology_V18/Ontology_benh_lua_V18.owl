    <ex:evidenceFrom rdf:resource="http://example.org/rice-cbm/ontology/v18#S01"/>
    <ex:limitation xml:lang="vi">Không tạo bệnh mục tiêu thứ năm. Dùng để làm rõ tổn thương bẹ không độc quyền khô vằn.</ex:limitation>
    <ex:meaningUsed xml:lang="vi">Giáo trình còn mô tả một bệnh khác ở bẹ ngoài bốn bệnh mục tiêu.</ex:meaningUsed>
    <ex:pdfPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">155</ex:pdfPage>
    <ex:printedPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">143</ex:printedPage>
    <ex:quote xml:lang="vi">Bệnh thối bẹ (Sheath rot)</ex:quote>
    <ex:statementType xml:lang="vi">Bối cảnh ngoài phạm vi</ex:statementType>
