    <ex:evidenceFrom rdf:resource="http://example.org/rice-cbm/ontology/v18#S01"/>
    <ex:meaningUsed xml:lang="vi">Khô vằn: vị trí trên bẹ và hình tròn hoặc bầu dục ban đầu.</ex:meaningUsed>
    <ex:pdfPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">155</ex:pdfPage>
    <ex:printedPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">143</ex:printedPage>
    <ex:quote xml:lang="vi">Trên bẹ lá, vết bệnh lúc đầu tròn hay bầu dục</ex:quote>
    <ex:statementType xml:lang="vi">Tri thức bệnh học</ex:statementType>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#Evidence"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">E15 – Khô vằn</rdfs:label>
