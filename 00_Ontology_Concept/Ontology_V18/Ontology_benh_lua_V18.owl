    <ex:trainNegative rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">370</ex:trainNegative>
    <ex:trainPositive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">125</ex:trainPositive>
    <ex:trainUnknown rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2155</ex:trainUnknown>
    <ex:usedInBottleneck rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:usedInBottleneck>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#VisualConcept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">Phần chính của đốm trên lá màu nâu lợt</rdfs:label>
    <skos:definition xml:lang="vi">Phần chính bên trong đốm trên lá có màu nâu lợt. Màu nâu sậm của viền được biểu diễn bằng C03.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#C08">
    <ex:assignedPer rdf:resource="http://example.org/rice-cbm/ontology/v18#U_TungVet"/>
    <ex:basis xml:lang="vi">Trực tiếp từ giáo trình</ex:basis>
    <ex:bottleneckStatus xml:lang="vi">Chờ rà lại (chưa đủ dữ liệu)</ex:bottleneckStatus>
    <ex:bottleneckTodo xml:lang="vi">Như C07.</ex:bottleneckTodo>
