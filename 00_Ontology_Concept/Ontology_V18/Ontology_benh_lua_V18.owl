    <ex:trainNegative rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">376</ex:trainNegative>
    <ex:trainPositive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1163</ex:trainPositive>
    <ex:trainUnknown rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1111</ex:trainUnknown>
    <ex:usedInBottleneck rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:usedInBottleneck>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#VisualConcept"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">Đốm hình tròn hoặc bầu dục</rdfs:label>
    <skos:definition xml:lang="vi">Một đốm có hình tròn hoặc bầu dục; không đặt yêu cầu nhỏ hoặc ngưỡng kích thước.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#C07">
    <ex:assignedPer rdf:resource="http://example.org/rice-cbm/ontology/v18#U_TungVet"/>
    <ex:basis xml:lang="vi">Trực tiếp từ giáo trình</ex:basis>
    <ex:bottleneckStatus xml:lang="vi">Đưa vào bottleneck</ex:bottleneckStatus>
    <ex:bottleneckTodo xml:lang="vi">Rà lại ảnh đốm nâu; bổ sung ảnh rõ dấu.</ex:bottleneckTodo>
    <ex:code>C07</ex:code>
    <ex:conceptStatus>ACTIVE_SOURCE</ex:conceptStatus>
