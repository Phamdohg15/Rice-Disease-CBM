  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#E16">
    <ex:bookSection>8.2.1.5</ex:bookSection>
    <ex:code>E16</ex:code>
    <ex:evidenceAbout rdf:resource="http://example.org/rice-cbm/ontology/v18#D_KhoVan"/>
    <ex:evidenceFrom rdf:resource="http://example.org/rice-cbm/ontology/v18#S01"/>
    <ex:limitation xml:lang="vi">Đoạn này không nói riêng tâm trắng.</ex:limitation>
    <ex:meaningUsed xml:lang="vi">Màu xám của vết và viền nâu ở khô vằn.</ex:meaningUsed>
    <ex:pdfPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">155</ex:pdfPage>
    <ex:printedPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">143</ex:printedPage>
    <ex:quote xml:lang="vi">màu xám có viền nâu</ex:quote>
    <ex:statementType xml:lang="vi">Tri thức bệnh học</ex:statementType>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#Evidence"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">E16 – Khô vằn</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#E17">
    <ex:bookSection>8.2.1.5</ex:bookSection>
    <ex:code>E17</ex:code>
    <ex:evidenceAbout rdf:resource="http://example.org/rice-cbm/ontology/v18#D_KhoVan"/>
    <ex:evidenceFrom rdf:resource="http://example.org/rice-cbm/ontology/v18#S01"/>
    <ex:meaningUsed xml:lang="vi">Khô vằn có diễn tiến lan không đều và biểu hiện loang lỗ vằn vện.</ex:meaningUsed>
    <ex:pdfPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">155</ex:pdfPage>
    <ex:printedPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">143</ex:printedPage>
    <ex:quote xml:lang="vi">sau lan ra không đều thành những vết loang lỗ vằn vện như da hổ</ex:quote>
    <ex:statementType xml:lang="vi">Diễn tiến và biểu hiện</ex:statementType>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#Evidence"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">E17 – Khô vằn</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#E18">
    <ex:bookSection>8.2.1.5</ex:bookSection>
    <ex:code>E18</ex:code>
    <ex:evidenceAbout rdf:resource="http://example.org/rice-cbm/ontology/v18#D_KhoVan"/>
    <ex:evidenceFrom rdf:resource="http://example.org/rice-cbm/ontology/v18#S01"/>
    <ex:limitation xml:lang="vi">Không dùng vị trí trên một ảnh để suy ngược cơ chế lây.</ex:limitation>
    <ex:meaningUsed xml:lang="vi">Diễn tiến từ bẹ lên phiến lá được sách mô tả trong trường hợp lan bằng hạch nấm.</ex:meaningUsed>
    <ex:pdfPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">155</ex:pdfPage>
    <ex:printedPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">143</ex:printedPage>
    <ex:quote xml:lang="vi">bệnh xuất hiện đầu tiên ở bẹ lá, rồi từ đó lan dần lên phiến lá</ex:quote>
    <ex:statementType xml:lang="vi">Diễn tiến có điều kiện</ex:statementType>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#Evidence"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">E18 – Khô vằn</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#E19">
    <ex:bookSection>8.2.1.5</ex:bookSection>
    <ex:code>E19</ex:code>
    <ex:evidenceAbout rdf:resource="http://example.org/rice-cbm/ontology/v18#D_KhoVan"/>
    <ex:evidenceFrom rdf:resource="http://example.org/rice-cbm/ontology/v18#S01"/>
    <ex:limitation xml:lang="vi">Lưu theo nguồn 2008; bản này không đánh giá tính cập nhật của cơ chế và không dùng làm luật ảnh.</ex:limitation>
    <ex:meaningUsed xml:lang="vi">Phát biểu của giáo trình về lan bằng bào tử.</ex:meaningUsed>
    <ex:pdfPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">155</ex:pdfPage>
    <ex:printedPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">143</ex:printedPage>
    <ex:quote xml:lang="vi">bệnh còn có thể lan truyền dưới dạng bào tử nấm bay trong không khí</ex:quote>
    <ex:statementType xml:lang="vi">Cơ chế theo nguồn</ex:statementType>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#Evidence"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">E19 – Khô vằn</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/rice-cbm/ontology/v18#E20">
    <ex:bookSection>8.2.1.5</ex:bookSection>
    <ex:code>E20</ex:code>
    <ex:evidenceAbout rdf:resource="http://example.org/rice-cbm/ontology/v18#D_KhoVan"/>
