    <ex:limitation xml:lang="vi">Chỉ biểu diễn phát biểu trong sách, không suy diễn từ ảnh tĩnh.</ex:limitation>
    <ex:meaningUsed xml:lang="vi">Diễn tiến từ phiến xuống bẹ trong trường hợp lan bằng bào tử được sách mô tả.</ex:meaningUsed>
    <ex:pdfPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">155</ex:pdfPage>
    <ex:printedPage rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">143</ex:printedPage>
    <ex:quote xml:lang="vi">bệnh sẽ lan dần từ phiến lá xuống bẹ lá</ex:quote>
    <ex:statementType xml:lang="vi">Diễn tiến có điều kiện</ex:statementType>
    <rdf:type rdf:resource="http://example.org/rice-cbm/ontology/v18#Evidence"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="vi">E20 – Khô vằn</rdfs:label>
  </rdf:Description>
