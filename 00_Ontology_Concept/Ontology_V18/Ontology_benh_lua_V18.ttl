    ex:describedForDisease ex:D_BacLa ,
        ex:D_KhoVan ;
    ex:hasEvidence ex:E16 ,
        ex:E23 ;
    ex:migrationFromV17 "C10 v1.8 = 1 nếu C10 v1.7 = 1 hoặc C17 v1.7 = 1; = 0 nếu cả hai = 0; còn lại = 9."@vi ;
    ex:observableOnLeafImages "true"^^xsd:boolean ;
