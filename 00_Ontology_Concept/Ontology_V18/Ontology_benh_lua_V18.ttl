<http://example.org/rice-cbm/ontology/v18>
    a owl:Ontology ;
    rdfs:comment "16 concept C01–C16 theo Bang_concept_v1_8. Nguồn bệnh học duy nhất: S01 Giáo trình Cây lúa (2008). Tổ hợp P01–P04 là thiết kế truy vấn nghiên cứu, không phải luật chẩn đoán. Không có SWRL hoặc tiên đề điều kiện đủ."@vi ;
    rdfs:label "Ontology bệnh lúa cho CBM – concept V1.8"@vi ;
    owl:priorVersion <https://example.org/rice-v16-two-books> ;
    owl:versionInfo "1.8.0" .

ex:BacterialDisease
    a owl:Class ;
    rdfs:label "Bệnh do vi khuẩn"@vi ;
    rdfs:subClassOf ex:RiceDisease .

ex:C01
    a ex:VisualConcept ,
        owl:NamedIndividual ;
    ex:assignedPer ex:U_TungVet ;
    ex:basis "Trực tiếp từ giáo trình"@vi ;
    ex:bottleneckStatus "Đưa vào bottleneck"@vi ;
    ex:bottleneckTodo "Rà lại ảnh đạo ôn (phóng to); bổ sung ảnh rõ dấu từ bộ paddy."@vi ;
    ex:code "C01" ;
    ex:conceptStatus "ACTIVE_SOURCE" ;
    ex:describedForDisease ex:D_DaoOn ;
    ex:hasEvidence ex:E01 ;
    ex:migrationFromV17 "Giữ nguyên mã và nhãn v1.7."@vi ;
    ex:observableOnLeafImages "true"^^xsd:boolean ;
    ex:rule0 "Vùng cần xét đủ rõ và xác nhận không có đặc điểm này; không suy từ nhãn bệnh."@vi ;
    ex:rule1 "Vùng cần xét đủ rõ và có đặc điểm đúng định nghĩa; lưu định danh vết/vùng tương ứng."@vi ;
    ex:rule9 "Không thấy đủ vùng cần xét, ảnh mờ, bị che/cắt hoặc không đủ chi tiết để quyết định."@vi ;
    ex:sourcePages "S01, tr. 141"@vi ;
    ex:trainNegative "489"^^xsd:integer ;
    ex:trainPositive "112"^^xsd:integer ;
    ex:trainUnknown "2049"^^xsd:integer ;
    ex:usedInBottleneck "true"^^xsd:boolean ;
    rdfs:label "Vết hình mắt én, hai đầu hẹp, giữa phình"@vi ;
    skos:definition "Một vết có phần giữa phình và hai đầu hẹp, tạo hình mắt én. Không yêu cầu hướng theo chiều lá."@vi .

